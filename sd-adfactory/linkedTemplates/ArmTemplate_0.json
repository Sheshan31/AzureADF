								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Get Metadata1",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get Metadata1').output.childItems",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "Get file Metadata activity",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "DelimitedText1",
											"type": "DatasetReference",
											"parameters": {
												"p_filename": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										},
										"fieldList": [
											"itemName",
											"itemType",
											"size"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "DelimitedTextReadSettings"
										}
									}
								},
								{
									"name": "If Condition on file size",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "Get file Metadata activity",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@greater(activity('Get file Metadata activity').output.size, 1000)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "Append variable small file name",
												"type": "AppendVariable",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"variableName": "smallfiles",
													"value": {
														"value": "@activity('Get file Metadata activity').output.itemName",
														"type": "Expression"
													}
												}
											}
										]
									}
								}
							]
						}
					},
					{
						"name": "Set final  variable",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "ForEach1",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "final_files",
							"value": {
								"value": "@string(variables('smallfiles'))",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"v1_filename": {
						"type": "String"
					},
					"v2_nooffiles": {
						"type": "Integer"
					},
					"has_data": {
						"type": "Boolean"
					},
					"if_true": {
						"type": "String"
					},
					"if_false": {
						"type": "String"
					},
					"smallfiles": {
						"type": "Array",
						"defaultValue": []
					},
					"final_files": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2025-10-04T05:35:02Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_source_csvfiles_folder')]",
				"[concat(variables('factoryId'), '/datasets/DelimitedText1')]"
			]
		},
